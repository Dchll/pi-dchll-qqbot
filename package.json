{
  "name": "pi-dchll-qqbot",
  "version": "0.0.2",
  "description": "Pi extension that connects the official QQ Bot API to the active native Pi coding agent session.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Dchll",
  "contributors": [
    "XiaoSQM"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dchll/pi-dchll-qqbot.git"
  },
  "homepage": "https://github.com/Dchll/pi-dchll-qqbot#readme",
  "bugs": {
    "url": "https://github.com/Dchll/pi-dchll-qqbot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "qq",
    "qqbot",
    "qq-bot",
    "coding-agent",
    "instant-messaging",
    "native-session",
    "remote-access"
  ],
  "files": [
    "src",
    "pi-dchll-qqbot.json.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Dchll/pi-dchll-qqbot/main/pi-dchll-qqbot.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx test/run-all.ts",
    "test:focused": "node --import tsx test/run-all.ts",
    "identity:check": "node scripts/check-identity.mjs",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "test:package": "node scripts/check-package.mjs",
    "smoke:pi": "node scripts/smoke-pi-load.mjs",
    "verify": "npm run identity:check && npm run typecheck && npm test",
    "prepack": "npm run verify",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "unpdf": "^1.6.2",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2.0.0",
    "@earendil-works/pi-tui": ">=1.4.0 <2.0.0",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  }
}
